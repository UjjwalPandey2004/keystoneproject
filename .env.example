POSTGRES_DB=keystone_db
POSTGRES_USER=keystone
POSTGRES_PASSWORD=replace-with-a-strong-local-password
JWT_SECRET=replace-with-at-least-32-random-characters
# true keeps the seeded demo accounts (password "password") and one-click logins. Local use only.
DEMO_MODE=false
# Used once, when DEMO_MODE is false, as the new password for admin@meridian.com (min 8 characters).
BOOTSTRAP_ADMIN_PASSWORD=
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENABLED=false
APP_BASE_URL=http://localhost:5173
CORS_ALLOWED_ORIGINS=http://localhost:5173
# Mail (SMTP). Needed in production for OTP verification and password-reset emails.
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
# Payments: UPI and UPI QR are offered only when UPI_VPA is set (e.g. keystone@okhdfcbank).
UPI_VPA=
UPI_PAYEE_NAME=KEYSTONE Facilities
# Where work-order photos/documents are stored. In the cloud: a persistent volume or mounted bucket.
STORAGE_DIR=./data/uploads
# "cloud" enables JSON logs, graceful shutdown and proxy headers (see application-cloud.properties).
SPRING_PROFILES_ACTIVE=
